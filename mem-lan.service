[Unit]
Description=mem — proxy LAN socket to loopback memory service
Requires=mem-lan.socket memory.service
After=mem-lan.socket memory.service
PartOf=mem-lan.socket

[Service]
Type=notify
ExecStart=/lib/systemd/systemd-socket-proxyd --exit-idle-time=300 127.0.0.1:3200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
