[Unit]
Description=mem — optional plaintext LAN forward (requires a trusted network)
Documentation=https://github.com/ktypez/mem
# Raw TCP forward only, not TLS. Keep disabled unless an encrypted tunnel or
# TLS proxy protects clients before traffic reaches this socket.
After=network-online.target
Wants=network-online.target

[Socket]
# Only the Wi-Fi LAN address, so the tailnet and the usb0 gadget network stay out.
ListenStream=192.168.1.47:3200
Accept=no
Service=mem-lan.service

# Deliberately no [Install] section: this plaintext listener is opt-in.
