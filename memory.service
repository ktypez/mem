[Unit]
Description=Hermes Memory Service (memoh-style knowledge graph)
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/.hermes
EnvironmentFile=/home/admin/.hermes/.env
ExecStart=/usr/bin/python3 /home/admin/.hermes/tools/memory_service.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target