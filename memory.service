[Unit]
Description=mem — Memory Service (Go/PostgreSQL knowledge graph)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/projects/mem
Environment=DATABASE_URL=postgres://mem:mem@localhost:5432/mem?sslmode=disable
ExecStart=/home/admin/projects/mem/mem
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
